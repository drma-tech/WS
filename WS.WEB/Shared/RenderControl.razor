@typeparam T

<div class="@Class">
    @if (PremiumFeature && !IsPremium)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Icon="@Icons.Material.Filled.Diamond" Style="text-align: justify;">
            <span class="me-2" style="font-weight: bold;">@Translations.Notification.PremiumFeature</span>
            @if (!string.IsNullOrEmpty(State.CustomPremiumDescription))
            {
                @State.CustomPremiumDescription
            }
        </MudAlert>
    }
    else if (PrivateFeature && !IsAuthenticated)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Icon="@Icons.Material.Filled.Lock" Style="text-align: justify;">
            @Translations.Module.Auth.UnauthenticatedUser
        </MudAlert>
    }
    else if (State.Status == RenderControlStatus.Loading)
    {
        <div style="position: relative;">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="@LoadingHeight" Animation="Animation.Wave" />
            <span style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-weight: 500;">
                @State.MessageLoading
            </span>
        </div>
    }
    else if (State.Status == RenderControlStatus.Error)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Icon="@Icons.Material.Filled.BugReport" Style="text-align: justify;">
            @(State.MessageError ?? Translations.Notification.RenderControlInvalid)
        </MudAlert>
    }
    else if (State.Status == RenderControlStatus.Warning)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Icon="@Icons.Material.Filled.Warning" Style="text-align: justify;">
            @(State.MessageWarning ?? Translations.Notification.RenderControlNoData)
        </MudAlert>
    }
    else //Content
    {
        @if (State.Instance == null || State.ExpressionEmpty(State.Instance))
        {
            if (EmptyFragment != null)
            {
                @EmptyFragment(State.Instance)
            }
            else if (HideIfEmpty)
            {
                <div></div>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Icon="@Icons.Material.Filled.Warning" Style="text-align: justify;">
                    @Translations.Notification.RenderControlNoData
                </MudAlert>
            }
        }
        else
        {
            @ChildContent(State.Instance)
        }
    }
</div>
