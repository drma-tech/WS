@using WS.Shared.Enums
@using Microsoft.JSInterop

@inject IJSRuntime JsRuntime

@if (CustomHeader != null)
{
    @CustomHeader
}
else
{
    <MudText Typo="Typo.h6" Color="Color.Info" Align="Align.Center" Class="@CssHelper.Build().Small("my")">
        @Translations.Module.Help.WriteReviewSubtitle
    </MudText>
}

@if (CurrentPlatform != Platform.webapp)
{
    <div class="@CssHelper.Build().Raw("store-grid").Small("mb")">
        @if (CurrentPlatform == Platform.windows && AppInfo.WindowsId.NotEmpty())
        {
            <MudButton Href="@_windowsReview" OnClick="Reviewed" Variant="Variant.Filled" FullWidth="true" Color="ActionColor" Class="vertical-button">
                <MudImage Src="/logo/microsoft-store.png" Style="max-width: 35px;" Alt="Microsoft Store"></MudImage> Microsoft Store (Store)
            </MudButton>
            <MudButton Href="@AppInfo.Stores.Single(p => p.Platform == Platform.windows).Url" Target="_blank" Rel="noopener" OnClick="Reviewed" Variant="Variant.Filled" FullWidth="true" Color="ActionColor" Class="vertical-button">
                <MudImage Src="/logo/microsoft-store.png" Style="max-width: 35px;" Alt="Microsoft Store"></MudImage> Microsoft Store (Site)
            </MudButton>
        }
        else if (CurrentPlatform == Platform.play && AppInfo.GoogleId.NotEmpty())
        {
            <MudButton Href="@_googleReview" OnClick="Reviewed" Variant="Variant.Filled" FullWidth="true" Color="ActionColor" Class="vertical-button">
                <MudImage Src="/logo/google-play.png" Style="max-width: 35px;" Alt="Google Play"></MudImage> Google Play (Store)
            </MudButton>
            <MudButton Href="@AppInfo.Stores.Single(p => p.Platform == Platform.play).Url" Target="_blank" Rel="noopener" OnClick="Reviewed" Variant="Variant.Filled" FullWidth="true" Color="ActionColor" Class="vertical-button">
                <MudImage Src="/logo/google-play.png" Style="max-width: 35px;" Alt="Google Play"></MudImage> Google Play (Site)
            </MudButton>
        }
        else if (CurrentPlatform == Platform.ios && AppInfo.AppleId.NotEmpty())
        {

            <MudButton Href="@_appleReview" OnClick="Reviewed" Variant="Variant.Filled" FullWidth="true" Color="ActionColor" Class="vertical-button">
                <MudImage Src="/logo/app-store.png" Style="max-width: 35px;" Alt="App Store"></MudImage> App Store (Store)
            </MudButton>
            <MudButton Href="@AppInfo.Stores.Single(p => p.Platform == Platform.ios).Url" Target="_blank" Rel="noopener" OnClick="Reviewed" Variant="Variant.Filled" FullWidth="true" Color="ActionColor" Class="vertical-button">
                <MudImage Src="/logo/app-store.png" Style="max-width: 35px;" Alt="App Store"></MudImage> App Store (Site)
            </MudButton>
        }
        else if (CurrentPlatform == Platform.huawei && AppInfo.HuaweiId.NotEmpty())
        {

            <MudButton Href="@_huaweiReview" OnClick="Reviewed" Variant="Variant.Filled" FullWidth="true" Color="ActionColor" Class="vertical-button">
                <MudImage Src="/logo/huawei.png" Style="max-width: 35px;" Alt="Huawei AppGallery"></MudImage> Huawei AppGallery (Store)
            </MudButton>
            <MudButton Href="@AppInfo.Stores.Single(p => p.Platform == Platform.huawei).Url" Target="_blank" Rel="noopener" OnClick="Reviewed" Variant="Variant.Filled" FullWidth="true" Color="ActionColor" Class="vertical-button">
                <MudImage Src="/logo/huawei.png" Style="max-width: 35px;" Alt="Huawei AppGallery"></MudImage> Huawei AppGallery (Site)
            </MudButton>
        }
        else if (CurrentPlatform == Platform.xiaomi && AppInfo.XiaomiId.NotEmpty())
        {

            <MudButton Href="@_xiaomiReview" OnClick="Reviewed" Variant="Variant.Filled" FullWidth="true" Color="ActionColor" Class="vertical-button">
                <MudImage Src="/logo/xiaomi.png" Style="max-width: 35px;" Alt="Xiaomi GetApps"></MudImage> Xiaomi GetApps (Store)
            </MudButton>
            <MudButton Href="@AppInfo.Stores.Single(p => p.Platform == Platform.xiaomi).Url" Target="_blank" Rel="noopener" OnClick="Reviewed" Variant="Variant.Filled" FullWidth="true" Color="ActionColor" Class="vertical-button">
                <MudImage Src="/logo/xiaomi.png" Style="max-width: 35px;" Alt="Xiaomi GetApps"></MudImage> Xiaomi GetApps (Site)
            </MudButton>
        }
        else if (CurrentPlatform == Platform.amazon && AppInfo.AmazonId.NotEmpty())
        {
            <MudButton Href="@_amazonReview" OnClick="Reviewed" Variant="Variant.Filled" FullWidth="true" Color="ActionColor" Class="vertical-button">
                <MudImage Src="/logo/amazon.png" Style="max-width: 35px;" Alt="Amazon Appstore"></MudImage> Amazon Appstore (Store)
            </MudButton>
            <MudButton Href="@AppInfo.Stores.Single(p => p.Platform == Platform.amazon).Url" Target="_blank" Rel="noopener" OnClick="Reviewed" Variant="Variant.Filled" FullWidth="true" Color="ActionColor" Class="vertical-button">
                <MudImage Src="/logo/amazon.png" Style="max-width: 35px;" Alt="Amazon Appstore"></MudImage> Amazon Appstore (Site)
            </MudButton>
        }
    </div>
}
else //webapp
{
    <div class="@CssHelper.Build().Raw("store-grid").Small("mb")">
        @if (AppInfo.WindowsId.NotEmpty())
        {
            <MudButton Href="@AppInfo.Stores.Single(p => p.Platform == Platform.windows).Url" Target="_blank" Rel="noopener" OnClick="Reviewed" Variant="Variant.Filled" FullWidth="true" Color="ActionColor" Class="vertical-button">
                <MudImage Src="/logo/microsoft-store.png" Style="max-width: 35px;" Alt="Microsoft Store"></MudImage> Microsoft Store
            </MudButton>
        }
        @if (AppInfo.GoogleId.NotEmpty())
        {
            <MudButton Href="@AppInfo.Stores.Single(p => p.Platform == Platform.play).Url" Target="_blank" Rel="noopener" OnClick="Reviewed" Variant="Variant.Filled" FullWidth="true" Color="ActionColor" Class="vertical-button">
                <MudImage Src="/logo/google-play.png" Style="max-width: 35px;" Alt="Google Play"></MudImage> Google Play
            </MudButton>
        }
        @if (AppInfo.AppleId.NotEmpty())
        {
            <MudButton Href="@AppInfo.Stores.Single(p => p.Platform == Platform.ios).Url" Target="_blank" Rel="noopener" OnClick="Reviewed" Variant="Variant.Filled" FullWidth="true" Color="ActionColor" Class="vertical-button">
                <MudImage Src="/logo/app-store.png" Style="max-width: 35px;" Alt="App Store"></MudImage> App Store
            </MudButton>
        }
        @if (AppInfo.HuaweiId.NotEmpty())
        {
            <MudButton Href="@AppInfo.Stores.Single(p => p.Platform == Platform.huawei).Url" Target="_blank" Rel="noopener" OnClick="Reviewed" Variant="Variant.Filled" FullWidth="true" Color="ActionColor" Class="vertical-button">
                <MudImage Src="/logo/huawei.png" Style="max-width: 35px;" Alt="Huawei AppGallery"></MudImage> Huawei AppGallery
            </MudButton>
        }
        @if (AppInfo.XiaomiId.NotEmpty())
        {
            <MudButton Href="@AppInfo.Stores.Single(p => p.Platform == Platform.xiaomi).Url" Target="_blank" Rel="noopener" OnClick="Reviewed" Variant="Variant.Filled" FullWidth="true" Color="ActionColor" Class="vertical-button">
                <MudImage Src="/logo/xiaomi.png" Style="max-width: 35px;" Alt="Xiaomi GetApps"></MudImage> Xiaomi GetApps
            </MudButton>
        }
        @if (AppInfo.AmazonId.NotEmpty())
        {
            <MudButton Href="@AppInfo.Stores.Single(p => p.Platform == Platform.amazon).Url" Target="_blank" Rel="noopener" OnClick="Reviewed" Variant="Variant.Filled" FullWidth="true" Color="ActionColor" Class="vertical-button">
                <MudImage Src="/logo/amazon.png" Style="max-width: 35px;" Alt="Amazon Appstore"></MudImage> Amazon Appstore
            </MudButton>
        }
    </div>
}

@if (ShowOtherApps)
{
    <MudText Typo="Typo.h6" Color="Color.Info" Align="Align.Center" Class="@CssHelper.Build().Small("my")">
        @Translations.Notification.CheckOurApps
    </MudText>

    <div class="@CssHelper.Build().Raw("store-grid").Small("mb")">
        @foreach (var product in AppInfo.Products)
        {
            if (product.Live)
            {
                <MudButton Href="@product.Url" Target="_blank" Rel="noopener" OnClick="Reviewed" Variant="Variant.Filled" FullWidth="true" Color="ActionColor" Class="vertical-button">
                    <div>
                        <MudImage Src="@product.Logo" Style="max-width: 35px; vertical-align: middle;" Alt="@product.Title"></MudImage>
                        <MudText Typo="Typo.subtitle1">
                            @product.Title
                        </MudText>
                    </div>
                    <MudText Typo="Typo.caption">
                        @product.SubTitle
                    </MudText>
                </MudButton>
            }
            else
            {
                <MudBadge Content="@("Beta")" Overlap="true" Color="Color.Warning">
                    <MudButton Href="@product.Url" Target="_blank" Rel="noopener" OnClick="Reviewed" Variant="Variant.Filled" FullWidth="true" Color="ActionColor" Class="vertical-button">
                        <div>
                            <MudImage Src="@product.Logo" Style="max-width: 35px; vertical-align: middle;" Alt="@product.Title"></MudImage>
                            <MudText Typo="Typo.subtitle1">
                                @product.Title
                            </MudText>
                        </div>
                        <MudText Typo="Typo.caption">
                            @product.SubTitle
                        </MudText>
                    </MudButton>
                </MudBadge>
            }
        }
    </div>
}

@if (ShowOtherApps)
{
    <MudDivider Class="@CssHelper.Build().Medium("my")"></MudDivider>
    <MudButton Disabled="CloseDisabled" Size="Size.Medium" Variant="Variant.Filled" FullWidth="true" Color="Color.Error" StartIcon="@Icons.Material.Filled.Close" OnClick="CloseClick" Class="@CssHelper.Build().Small("mb")">
        @Translations.Button.Close
        @if (CloseDisabled)
        {
            <MudProgressCircular Value="10 - CloseCountdown" Max="10" Size="Size.Small" Color="Color.Warning" Class="ms-3">
                @CloseCountdown
            </MudProgressCircular>
        }
    </MudButton>
}

<style>
    .store-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(85px, 1fr));
        gap: 8px;
    }
</style>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public RenderFragment? CustomHeader { get; set; }
    [Parameter] public bool ShowOtherApps { get; set; } = true;
    [Parameter] public bool ShowClose { get; set; } = true;
    [Parameter] public Color ActionColor { get; set; } = Color.Primary;

    public Platform CurrentPlatform { get; set; }

    private bool CloseDisabled { get; set; } = true;
    private int CloseCountdown { get; set; } = 10;

    private readonly string _windowsReview = $"ms-windows-store://review/?ProductId={AppInfo.WindowsId}"; //its working
    private readonly string _googleReview = $"market://details?id={AppInfo.GoogleId}"; //its old. better to use In-App Review API.
    private readonly string _appleReview = $"itms-apps://itunes.apple.com/app/{AppInfo.AppleId}?action=write-review"; //its working
    private readonly string _huaweiReview = $"appmarket://details?id={AppInfo.HuaweiId}"; //It may work or it may not.
    private readonly string _xiaomiReview = $"mimarket://details?id={AppInfo.XiaomiId}"; //It may work or it may not.
    private readonly string _amazonReview = $"amzn://apps/android?asin={AppInfo.AmazonId}"; //not sure if works

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        CurrentPlatform = await AppStateStatic.GetPlatform(JsRuntime, CancellationToken.None);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await StartCloseCountdown();
        }
    }

    private async Task StartCloseCountdown()
    {
        while (CloseCountdown > 0)
        {
            await Task.Delay(1000);

            CloseCountdown--;
            StateHasChanged();
        }

        CloseDisabled = false;
        StateHasChanged();
    }

    private async Task Reviewed()
    {
        await JsRuntime.Utils().SetStorage("store-reviewed", true, JavascriptContext.Default.Boolean, CancellationToken.None);
    }

    private void CloseClick()
    {
        MudDialog?.Close();
    }
}
